{
  "name": "mtfg-paperclip",
  "version": "0.1.0",
  "private": true,
  "description": "MTFG Paperclip — Ritim · Rutin · Tetikleyici · Sinyal orkestrasyon sistemi (Canlı Kalp)",
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "dev": "pnpm --filter @paperclip/server dev",
    "migrate": "pnpm --filter @paperclip/server migrate",
    "start": "pnpm --filter @paperclip/server start"
  },
  "workspaces": [
    "packages/*",
    "server",
    "ui"
  ],
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  }
}
