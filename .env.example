# ── MTFG Paperclip — Ortam Değişkenleri (örnek) ──
# Gerçek değerleri .env dosyasına koyun; .env asla commit edilmez.

# Sunucu
PORT=3000
NODE_ENV=development

# PostgreSQL (Railway "DATABASE_URL" değişkenini otomatik sağlar)
DATABASE_URL=postgresql://user:password@localhost:5432/paperclip

# Google Workspace entegrasyonu (READONLY — dış gönderim YASAK)
# Faz 0.3'te kullanılacak. Servis hesabı veya OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Tarayıcıdan bağlama (önerilen): /auth/google ile bağlan → refresh token DB'ye yazılır.
# CLI ile üretirsen buraya da koyabilirsin (DB'de token varsa o önceliklidir).
GOOGLE_REFRESH_TOKEN=
# Tarayıcı akışı için dönüş adresi. Web client'ta "Authorized redirect URI" olarak BUNU ekle.
# Boş bırakılırsa istekteki host'tan türetilir (ör. https://<app>.up.railway.app/auth/google/callback).
GOOGLE_REDIRECT_URI=
# Sadece readonly scope: gmail.readonly, calendar.readonly

# Uygulama yapılandırması (Config tablosuna seed edilir)
TZ=Europe/Istanbul

# Scheduler (ritim cron'ları). Prod'da true yapın; Railway cron kullanıyorsanız false bırakın.
SCHEDULER_ENABLED=false
